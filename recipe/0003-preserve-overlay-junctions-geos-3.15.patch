+  /* 2.2. Split by overlay junctions
+   *
+   * GEOS >= 3.15 returns line-merged overlay output, hiding the
+   * junctions between shared and non-shared linework inside line
+   * interiors. Splitting restores them; older GEOS keeps them as
+   * component boundaries and the split is a no-op. This must come
+   * after the unary union of step 2.1, which would merge them again.
+   */
+  if ( xsplit )
+  {
+    if ( ! rtgeom_is_empty(iface->ctx, xsplit) )
+    {
+      tmp = _rtt_split_by_nodes(iface->ctx, noded, xsplit);
+      rtgeom_free(iface->ctx, noded);
+      noded = tmp;
+      RTDEBUGG(iface->ctx, 1, noded, "Overlay-junction-split");
+    }
+    rtgeom_free(iface->ctx, xsplit);
+  }
+
+  /* 2.3. Split by the endpoints of the input line
+   *
+   * GEOS >= 3.15 also line-merges across the start point of a closed
+   * input line, which older GEOS kept as a component boundary, and
+   * hence as a node, unless it fell on linework shared with existing
+   * edges. Split there again; for an open line, or with older GEOS,
+   * the split is a no-op.
+   */
+  if ( line->points && line->points->npoints > 1 )
+  {{
+    RTGEOM *ends[2];
+    int nends = 0;
+    int k;
+    for (k = 0; k < 2; ++k)
+    {
+      RTPOINT *pt = rtline_get_rtpoint(iface->ctx, line,
+                                       k ? line->points->npoints - 1 : 0);
+      if ( ! pt ) continue;
+      if ( xshared && ! rtgeom_is_empty(iface->ctx, xshared) &&
+           rtgeom_mindistance2d(iface->ctx, rtpoint_as_rtgeom(iface->ctx, pt), xshared) == 0 )
+      {
+        /* on shared linework: older GEOS did not keep it either */
+        rtpoint_free(iface->ctx, pt);
+        continue;
+      }
+      ends[nends++] = rtpoint_as_rtgeom(iface->ctx, pt);
+    }
+    if ( nends )
+    {
+      RTCOLLECTION *ecol = rtcollection_construct(iface->ctx, RTMULTIPOINTTYPE,
+                                                  noded->srid, NULL, nends, ends);
+      tmp = _rtt_split_by_nodes(iface->ctx, noded, rtcollection_as_rtgeom(iface->ctx, ecol));
+      rtgeom_free(iface->ctx, noded);
+      noded = tmp;
+      RTDEBUGG(iface->ctx, 1, noded, "Endpoint-split");
+      rtcollection_release(iface->ctx, ecol);
+    }
+    for (k = 0; k < nends; ++k) rtgeom_free(iface->ctx, ends[k]);
+  }}
+  if ( xshared ) rtgeom_free(iface->ctx, xshared);
+
   RTDEBUGG(iface->ctx, 1, noded, "Finally-noded");
 
