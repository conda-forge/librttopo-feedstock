 /*
+ * Release a collection returned by rtcollection_extract or
+ * rtgeom_as_multi, whose components are shallow clones.
+ */
+static void
+_rtt_release_shallow_collection(const RTCTX *ctx, RTCOLLECTION *col)
+{
+  int i;
+  if ( ! col ) return;
+  for (i=0; i<col->ngeoms; ++i) rtgeom_release(ctx, col->geoms[i]);
+  if ( col->geoms ) rtfree(ctx, col->geoms);
+  col->geoms = NULL;
+  col->ngeoms = 0;
+  rtcollection_release(ctx, col);
+}
+
+/*
+ * Mod-2 boundary of a lineal geometry, computed by GEOS.
+ * Returns NULL on error.
+ */
+static RTGEOM *
+_rtt_lineal_boundary(const RTCTX *ctx, const RTGEOM *g)
+{
+  GEOSGeometry *gg, *gb;
+  RTGEOM *ret;
+
+  _rtt_EnsureGeos(ctx);
+
+  gg = RTGEOM2GEOS(ctx, g, 0);
+  if ( ! gg )
+  {
+    rterror(ctx, "Could not convert geometry to GEOS: %s",
+            rtgeom_get_last_geos_error(ctx));
+    return NULL;
+  }
+  gb = GEOSBoundary_r(ctx->gctx, gg);
+  GEOSGeom_destroy_r(ctx->gctx, gg);
+  if ( ! gb )
+  {
+    rterror(ctx, "Could not compute boundary: %s",
+            rtgeom_get_last_geos_error(ctx));
+    return NULL;
+  }
+  ret = GEOS2RTGEOM(ctx, gb, RTFLAGS_GET_Z(g->flags));
+  GEOSGeom_destroy_r(ctx->gctx, gb);
+  return ret;
+}
+
+/*
+ * Compute the junction points between the overlay intersection linework
+ * (shared paths and crossings between the noded line and nearby edges)
+ * and the rest of the noded line: the 0-dimensional intersection
+ * components plus the mod-2 boundary of the 1-dimensional ones.
+ *
+ * These junctions must become topology nodes. GEOS >= 3.15 returns
+ * overlay output line-merged, which would otherwise hide them inside
+ * line interiors. Older GEOS keeps them as boundaries of the overlay
+ * output components, making a split at them a no-op.
+ *
+ * Backported from PostGIS commit ca3323d8c748dd806bab188028bb61c5f67b39af
+ * (https://github.com/postgis/postgis/pull/1160).
+ *
+ * Returns a MULTIPOINT.
+ */
+static RTGEOM *
+_rtt_overlay_split_points(const RTCTX *ctx, const RTGEOM *xset)
+{
+  RTGEOM *multi;
+  RTCOLLECTION *xcol, *epoints, *lines;
+  RTCOLLECTION *points;
+  RTGEOM *bnd;
+  int i;
+
+  points = rtcollection_construct_empty(ctx, RTMULTIPOINTTYPE, xset->srid,
+                                        RTFLAGS_GET_Z(xset->flags),
+                                        RTFLAGS_GET_M(xset->flags));
+  if ( rtgeom_is_empty(ctx, xset) ) return rtcollection_as_rtgeom(ctx, points);
+
+  multi = rtgeom_as_multi(ctx, xset);
+  xcol = rtgeom_as_rtcollection(ctx, multi);
+  if ( ! xcol )
+  {
+    rtgeom_release(ctx, multi); /* shallow clone, see rtgeom_as_multi */
+    return rtcollection_as_rtgeom(ctx, points);
+  }
+
+  epoints = rtcollection_extract(ctx, xcol, RTPOINTTYPE);
+  lines = rtcollection_extract(ctx, xcol, RTLINETYPE);
+
+  for (i = 0; i < epoints->ngeoms; i++)
+    rtcollection_add_rtgeom(ctx, points, rtgeom_clone_deep(ctx, epoints->geoms[i]));
+
+  if ( lines->ngeoms )
+  {
+    bnd = _rtt_lineal_boundary(ctx, rtcollection_as_rtgeom(ctx, lines));
+    if ( bnd )
+    {
+      RTCOLLECTION *bcol = rtgeom_as_rtcollection(ctx, bnd);
+      if ( bcol )
+      {
+        for (i = 0; i < bcol->ngeoms; i++)
+          rtcollection_add_rtgeom(ctx, points, rtgeom_clone_deep(ctx, bcol->geoms[i]));
+      }
+      else if ( ! rtgeom_is_empty(ctx, bnd) )
+      {
+        rtcollection_add_rtgeom(ctx, points, rtgeom_clone_deep(ctx, bnd));
+      }
+      rtgeom_free(ctx, bnd);
+    }
+  }
+
+  _rtt_release_shallow_collection(ctx, epoints);
+  _rtt_release_shallow_collection(ctx, lines);
+  /* rtgeom_as_multi returns shallow clones of the components of xset */
+  _rtt_release_shallow_collection(ctx, xcol);
+
+  points->srid = xset->srid;
+  return rtcollection_as_rtgeom(ctx, points);
+}
